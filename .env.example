# ============================================================
# qoderbuddy2api — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# Multiple tokens for the same provider are comma-separated:
#   CODEBUDDY_TOKEN=key1,key2,key3
#   QODER_TOKEN=pt_key1,pt_key2,pt_key3

# --- CodeBuddy API Keys ---
# Obtain from your CodeBuddy account settings.
CODEBUDDY_TOKEN=ck_xxx

# --- Qoder CN Personal Access Tokens ---
# Obtain from https://qoder.com.cn/account/integrations
QODER_TOKEN=pt_xxx

# --- Server ---
# QB2API_HOST=0.0.0.0
# QB2API_PORT=9999
# QB2API_LOG_LEVEL=info              # debug | info | warning | error
# QB2API_API_KEY=                    # optional: protect API with a bearer token

# --- Advanced ---
# CODEBUDDY_ENDPOINT=https://copilot.tencent.com
# QODER_TIMEOUT=300                  # seconds
# QB2API_LOG_REQUESTS=true
# QB2API_LOG_DIR=./logs
# QB2API_MODEL_CONFIG=./config/models.json
