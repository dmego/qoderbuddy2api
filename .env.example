# 2api control plane and proxy worker
# Copy to .env. Never commit real keys or credential master keys.

# Static provider accounts (optional; comma-separated for multiple accounts).
CODEBUDDY_TOKEN=ck_xxx
QODER_TOKEN=pt_xxx

# Separate trust domains. The deprecated QB2API_API_KEY is only a proxy alias.
QB2API_PROXY_API_KEY=replace-with-client-proxy-key
QB2API_ADMIN_KEY=replace-with-independent-admin-key
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
QB2API_CREDENTIAL_KEY=replace-with-fernet-key

# Control plane and supervised Worker. Bind the control plane to a Tailscale IP
# only when remote administration is required; never expose it to the Internet.
QB2API_CONTROL_HOST=127.0.0.1
QB2API_CONTROL_PORT=9999
QB2API_WORKER_HOST=127.0.0.1
QB2API_WORKER_PORT=10001
QB2API_WORKER_AUTOSTART=true
QB2API_ADMIN_UI_ENABLED=true
QB2API_DATA_DIR=./data

# Cookie transport policy:
#   auto  = HTTPS, or loopback HTTP; rejects remote HTTP (recommended default)
#   true  = HTTPS only
#   false = explicit trusted Tailscale/LAN HTTP override; no TLS protection
QB2API_ADMIN_COOKIE_SECURE=auto
QB2API_ADMIN_SESSION_TTL_HOURS=12
QB2API_ADMIN_SESSION_IDLE_MINUTES=60

# Only enable forwarded headers behind a known reverse proxy and list its CIDR.
QB2API_TRUSTED_PROXY_HEADERS=false
# QB2API_TRUSTED_PROXY_NETWORKS=100.64.0.0/10

# Provider/check-in defaults.
CODEBUDDY_ENDPOINT=https://copilot.tencent.com
QODER_TIMEOUT=300
CHECKIN_ENABLED=false
CODEBUDDY_CHECKIN_ENABLED=false
QODER_CHECKIN_ENABLED=false
CHECKIN_AT=00:10
CHECKIN_TIMEZONE=Asia/Shanghai

# Logs and model catalog.
QB2API_LOG_LEVEL=info
QB2API_LOG_REQUESTS=true
QB2API_LOG_DIR=./logs
QB2API_MODEL_CONFIG=./config/models.json
