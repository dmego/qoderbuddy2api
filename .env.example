# qoderbuddy2api Control Plane and supervised Proxy Worker.
# Copy to .env, provide distinct values, then chmod 600 .env. Never commit it.
# Never put keys/tokens in a URL, browser storage, screenshots, or normal logs.

# Separate trust domains. QB2API_API_KEY is a deprecated Proxy-only alias;
# leave it unset in new deployments.
QB2API_PROXY_API_KEY=
QB2API_ADMIN_KEY=
# Generate locally: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
QB2API_CREDENTIAL_KEY=
# QB2API_API_KEY=

# Control Plane is the only service-manager process. It starts the Worker.
QB2API_MODE=control
QB2API_CONTROL_HOST=127.0.0.1
QB2API_CONTROL_PORT=9999
# 统一入口：客户端只填 http://127.0.0.1:9999/v1，Control Plane 把 /v1/* 转发到 Worker
QB2API_WORKER_HOST=127.0.0.1
QB2API_WORKER_PORT=10001
QB2API_WORKER_AUTOSTART=true
QB2API_WORKER_START_TIMEOUT_SECONDS=30
QB2API_WORKER_HEALTH_INTERVAL_SECONDS=1
# Maximum wait after verified SIGTERM before Supervisor sends verified SIGKILL.
QB2API_WORKER_SHUTDOWN_TIMEOUT_SECONDS=15
# Blank creates a 0600 file at $QB2API_DATA_DIR/worker.internal. Never reuse Admin/Proxy keys.
QB2API_WORKER_INTERNAL_TOKEN=

# Legacy values. The current split entrypoint uses explicit CONTROL/WORKER ports.
QB2API_HOST=0.0.0.0
QB2API_PORT=9999

# SQLite, automatic internal token, and managed backups live below DATA_DIR.
QB2API_DATA_DIR=./data
QB2API_LOG_DIR=./logs
QB2API_LOG_LEVEL=info
QB2API_LOG_REQUESTS=true
QB2API_MODEL_CONFIG=./config/models.json

# Qoder 上游模型目录自动同步：默认启用，每 6 小时从官方接口刷新一次
# QB2API_MODEL_SYNC_ENABLED=true
# QB2API_MODEL_SYNC_INTERVAL_SECONDS=21600

# `auto`: loopback HTTP or remote HTTPS. `false`: explicit trusted Tailscale/LAN
# HTTP exception; never public Internet. `true`: require HTTPS everywhere.
QB2API_ADMIN_UI_ENABLED=true
QB2API_ADMIN_UI_PATH=/admin
QB2API_ADMIN_COOKIE_SECURE=auto
QB2API_ADMIN_SESSION_TTL_HOURS=12
QB2API_ADMIN_SESSION_IDLE_MINUTES=60
# Enable only behind a known direct reverse-proxy peer that overwrites headers.
QB2API_TRUSTED_PROXY_HEADERS=false
# QB2API_TRUSTED_PROXY_NETWORKS=127.0.0.1/32

# Optional legacy transient chat slots. Use Admin UI import for durable accounts.
CODEBUDDY_TOKEN=
CODEBUDDY_ENDPOINT=https://copilot.tencent.com
CODEBUDDY_OAUTH_ENABLED=true
CODEBUDDY_OAUTH_TIMEOUT_SECONDS=20
CODEBUDDY_OAUTH_REFRESH_SKEW_SECONDS=120
QODER_TOKEN=
QODER_TIMEOUT=300
PROVIDER_DRAIN_TIMEOUT_SECONDS=330

# 流式响应透传 reasoning_content：WorkBuddy/Qoder 思考模型的推理步骤。
# 默认 true；设为 false 可在流式输出时剥离思考、只保留正文。
# QB2API_STREAM_REASONING=true
# WorkBuddy 模型默认不产思考，需带 reasoning_effort 才触发。
# 客户端未传时注入此默认档位（low/medium/high/max）；留空关闭注入。
# 注意：hy3 忽略 medium，low/high 才产思考，默认 low 覆盖全部模型。
QB2API_CODEBUDDY_DEFAULT_REASONING_EFFORT=low

# Check-in and metrics. Keep disabled until each purpose has a verified credential.
CHECKIN_ENABLED=false
CHECKIN_AT=00:10
CHECKIN_TIMEZONE=Asia/Shanghai
CHECKIN_CATCH_UP=true
CHECKIN_CATCH_UP_WINDOW_HOURS=6
CHECKIN_JITTER_MIN_SECONDS=3
CHECKIN_JITTER_MAX_SECONDS=10
CHECKIN_REQUEST_TIMEOUT_SECONDS=15
CHECKIN_RETRY_LIMIT=2
GROWTH_AUTO_ACTIVE_DAY=true
# 活跃日未点亮时，先尝试补一次签到(幂等；已签到则跳过)再走 ACP 对话。
# 修复"凌晨 UTC 日界线误判已点亮导致漏点"及补签没成功的空档。
GROWTH_AUTO_ACTIVE_DAY_RECHECKIN=true
# GROWTH_ACTIVE_DAY_CONFIRM_ATTEMPTS=3
# 活跃日当日尝试预算(含确认)，耗尽前会反复重试直到官方点亮；跨日自动重置。
# GROWTH_ACTIVE_DAY_MAX_ATTEMPTS=6
CODEBUDDY_CHECKIN_ENABLED=false

CODEBUDDY_CHECKIN_BASE=https://www.workbuddy.cn
CODEBUDDY_CHECKIN_STATUS_PATH=/billing/meter/checkin-status
CODEBUDDY_CHECKIN_STATUS_METHOD=
CODEBUDDY_CHECKIN_CLAIM_PATH=/billing/meter/daily-checkin
CODEBUDDY_CHECKIN_CLAIM_METHOD=POST
CODEBUDDY_CREDITS_PATH=/billing/meter/get-user-resource
QODER_CHECKIN_ENABLED=false
QODER_CHECKIN_BASE=https://openapi.qoder.com.cn
QODER_ACTIVITY_BASE=https://gateway.qoder.com.cn
QODER_CHECKIN_STATUS_PATH=/sash/api/v1/me/daily-check-in/status
QODER_CHECKIN_CLAIM_PATH=/sash/api/v1/me/daily-check-in/claim
QODER_CHECKIN_REFRESH_PATH=/api/v1/deviceToken/refresh
QODER_QUOTA_PATH=/api/v2/quota/usage
QODER_ACTIVITY_PATH=/algo/api/v2/activity
QB2API_METRICS_ENABLED=true
QB2API_METRICS_INTERVAL_SECONDS=900
QB2API_METRICS_HISTORY_RETENTION_DAYS=90
QB2API_USAGE_ROLLUP_INTERVAL_SECONDS=60
QB2API_USAGE_DETAIL_RETENTION_DAYS=90
