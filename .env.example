# qoderbuddy2api —— WorkBuddy 账号池的 OpenAI / Anthropic 兼容入口。
# 复制为 .env，填入互不相同的值，然后 chmod 600 .env。不要提交这个文件。
# 任何密钥/token 都不要放进 URL、浏览器存储、截图或普通日志。

# ---- 三个必需密钥（各自独立，不要复用）----
# 客户端调用 /v1/* 时使用的代理密钥
QB2API_PROXY_API_KEY=
# 管理台登录密钥
QB2API_ADMIN_KEY=
# 凭据加密主密钥。生成方式：
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 换掉它等于所有已导入账号需要重新登录。
QB2API_CREDENTIAL_KEY=

# ---- 监听 ----
# 单进程同时提供：代理（/v1/*）、管理 API（/api/admin/*）、管理台（/admin）。
# 对外只需要映射这一个端口。
QB2API_HOST=0.0.0.0
QB2API_PORT=9999

# ---- 存储 ----
# SQLite、备份、日志目录。运行用户需要独占访问。
QB2API_DATA_DIR=./data
QB2API_LOG_DIR=./logs
QB2API_LOG_LEVEL=info
QB2API_LOG_REQUESTS=true
QB2API_MODEL_CONFIG=./config/models.json
# 管理台静态资源目录；默认自动探测（可执行文件旁的 web/dist）
# QB2API_WEB_DIR=./web/dist

# ---- 写盘节流 ----
# 请求遥测按批写入，避免每个请求一次事务。数值越大 = 写盘次数越少。
QB2API_EVENT_FLUSH_MILLIS=250
QB2API_EVENT_FLUSH_MAX=200

# ---- 管理台会话与远程访问 ----
# `auto`：本机 HTTP 或远程 HTTPS 均可；`false`：显式信任的局域网 HTTP（不要暴露公网）；
# `true`：一律要求 HTTPS。
QB2API_ADMIN_UI_ENABLED=true
QB2API_ADMIN_UI_PATH=/admin
QB2API_ADMIN_COOKIE_SECURE=auto
QB2API_ADMIN_SESSION_TTL_HOURS=12
QB2API_ADMIN_SESSION_IDLE_MINUTES=60
# 仅当明确有 HTTPS 反向代理直连、且会覆盖转发头时才开启。
QB2API_TRUSTED_PROXY_HEADERS=false
# QB2API_TRUSTED_PROXY_NETWORKS=127.0.0.1/32

# ---- 上游 provider ----
# 国内 WorkBuddy（provider id 为 codebuddy，数据库与 API 均以此为准）
CODEBUDDY_ENDPOINT=https://copilot.tencent.com
CODEBUDDY_CHECKIN_BASE=https://www.workbuddy.cn
CODEBUDDY_OAUTH_ENABLED=true
CODEBUDDY_OAUTH_TIMEOUT_SECONDS=20
# WorkBuddy 国际版（仅对话，无签到与成长中心）
WORKBUDDY_INTL_ENDPOINT=https://www.workbuddy.ai
WORKBUDDY_INTL_OAUTH_ENABLED=true
WORKBUDDY_INTL_CREDITS_PATH=/billing/meter/get-user-resource

# 旧式静态 token（逗号分隔），仅用于临时试用；长期账号请在管理台导入。
CODEBUDDY_TOKEN=
WORKBUDDY_INTL_TOKEN=

# 思考透传：流式输出保留思考过程。WorkBuddy 模型需带 reasoning_effort 才产思考。
QB2API_STREAM_REASONING=true
# 客户端未显式传 reasoning_effort 时的注入值；留空则完全不注入。
# low 可覆盖全部模型；hy3 会忽略 medium。
QB2API_CODEBUDDY_DEFAULT_REASONING_EFFORT=max
QB2API_INTL_DEFAULT_REASONING_EFFORT=low

# ---- 凭据主动轮换 ----
# 短效 token 在到期前刷新，避免需要手动重新登录。
QB2API_CREDENTIAL_REFRESH_ENABLED=true
QB2API_CREDENTIAL_REFRESH_INTERVAL_SECONDS=900
QB2API_CREDENTIAL_REFRESH_LEAD_SECONDS=1800

# ---- 签到调度 ----
CHECKIN_ENABLED=false
CHECKIN_AT=00:10
CHECKIN_TIMEZONE=Asia/Shanghai
CHECKIN_CATCH_UP=true
CHECKIN_CATCH_UP_WINDOW_HOURS=6
CHECKIN_JITTER_MIN_SECONDS=3
CHECKIN_JITTER_MAX_SECONDS=10
CHECKIN_REQUEST_TIMEOUT_SECONDS=15
CHECKIN_RETRY_LIMIT=2
CODEBUDDY_CHECKIN_ENABLED=false
CODEBUDDY_CHECKIN_STATUS_PATH=/billing/meter/checkin-status
CODEBUDDY_CHECKIN_CLAIM_PATH=/billing/meter/daily-checkin
CODEBUDDY_CREDITS_PATH=/billing/meter/get-user-resource

# ---- 指标采集 ----
QB2API_METRICS_ENABLED=true
QB2API_METRICS_INTERVAL_SECONDS=900
QB2API_METRICS_HISTORY_RETENTION_DAYS=90

# ---- 用量遥测 ----
QB2API_USAGE_ROLLUP_INTERVAL_SECONDS=60
QB2API_USAGE_DETAIL_RETENTION_DAYS=90

# ---- 成长中心自动化 ----
GROWTH_SCHEDULER_ENABLED=true
GROWTH_SCHEDULER_INTERVAL_SECONDS=1800
GROWTH_AUTO_TASKS=true
GROWTH_AUTO_LOTTERY=true
GROWTH_AUTO_TRAVEL=true
GROWTH_AUTO_REDEEM=true
GROWTH_REDEEM_TIER=14d
GROWTH_AUTO_BUDDY_OPEN=false
# 活跃日：每日执行一次正式对话点亮当天，与签到解耦。
GROWTH_AUTO_ACTIVE_DAY=true

# 以上大部分调度类配置也可在管理台「设置」页修改，运行时设置优先于此处的启动默认值。
