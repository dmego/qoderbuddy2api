[Unit]
Description=qoderbuddy2api Control Plane (owns Proxy Worker)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=qb2api
Group=qb2api
WorkingDirectory=/opt/qb2api
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/qb2api/qb2api.env
ExecStart=/opt/qb2api/.venv/bin/qb2api --mode control
Restart=on-failure
RestartSec=5
TimeoutStopSec=360
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/qb2api /var/log/qb2api

[Install]
WantedBy=multi-user.target
