<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cn.qb2api.control</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/REPLACE_ME/qb2api/.venv/bin/qb2api</string>
    <string>--mode</string>
    <string>control</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/REPLACE_ME/qb2api</string>
  <key>EnvironmentVariables</key>
  <dict><key>PYTHONUNBUFFERED</key><string>1</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE_ME/qb2api/logs/launchd-control.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_ME/qb2api/logs/launchd-control.stderr.log</string>
</dict>
</plist>
