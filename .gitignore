# Build artifacts
dist/
build/
*.exe
qb2api

# Python-era caches (kept so a stale checkout stays clean)
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
.ruff_cache/

# Local configuration and secrets
.env
.env.*
!.env.example
creds/

# Runtime state: never commit a database or request log
data/
logs/
*.sqlite3
*.sqlite3-*
*.log
nohup.out

# Local deployment scratch
go-deploy/switch-*/
go-deploy/*.log

node_modules/
frontend/node_modules/
frontend/test-results/

.DS_Store
.worktrees/
.claude/

# The admin console is built from frontend/ and committed as served assets.
!frontend/package-lock.json
!web/dist/
!web/dist/**
